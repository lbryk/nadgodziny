# Reverse proxy with HTTPS in front of the Node server (listening on 127.0.0.1:3000).
# Remember: TRUST_PROXY=1 and COOKIE_SECURE=1 in .env.
server {
    listen 80;
    server_name nadgodziny.example.pl;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name nadgodziny.example.pl;

    ssl_certificate     /etc/letsencrypt/live/nadgodziny.example.pl/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/nadgodziny.example.pl/privkey.pem;

    client_max_body_size 2m;

    location / {
        proxy_pass         http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }
}

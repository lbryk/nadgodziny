# Static hosting on Apache: serve index.html for client-side routes (/kalendarz, /zasady, /admin).
# Not needed when the Node server serves the app — it has the same fallback built in.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|gz)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "(index\.html|theme-init\.js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

AddType application/wasm .wasm

# Copy to .env (Docker Compose) or export in the environment (Node).

# --- required in production ------------------------------------------------
# Password of the administrator. Used to create the account on first start; after the
# password is changed in the panel this value is ignored (set ADMIN_PASSWORD_RESET=1 to force it).
ADMIN_PASSWORD=change-me-to-a-long-passphrase

# --- optional --------------------------------------------------------------
ADMIN_USER=admin
PORT=3000
HOST=0.0.0.0
# Directory with store.json (settings, school calendar, admin password hash). Back it up.
DATA_DIR=./data
# Session length of the administrator panel, hours
SESSION_HOURS=8
# Login attempts per minute and IP
LOGIN_RATE_LIMIT=8
# Set to 1 when the site is served over HTTPS (cookie gets the Secure flag)
COOKIE_SECURE=0
# Set to 1 behind a reverse proxy (nginx, Traefik, Caddy) so real client IPs are used for rate limiting
TRUST_PROXY=0
# Fixed secret for session tokens (otherwise generated once and kept in store.json)
# JWT_SECRET=
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

{
  "name": "nadgodziny",
  "version": "1.0.0",
  "private": true,
  "description": "Kalkulator nadgodzin nauczycieli — wariant uśredniony i rozliczenie tygodniowe wg kalendarza roku szkolnego.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm run dev -w @nadgodziny/server\" \"npm run dev -w @nadgodziny/web\"",
    "build": "npm run build -w @nadgodziny/web && npm run build -w @nadgodziny/server",
    "start": "npm run start -w @nadgodziny/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "package": "npm run build && node scripts/package-release.mjs",
    "package:ftp": "npm run build:ftp -w @nadgodziny/web && node scripts/package-ftp.mjs",
    "gen:php-defaults": "tsx scripts/gen-php-defaults.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
